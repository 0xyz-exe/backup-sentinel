# Backup Sentinel Environment Configuration Example

APP_NAME="Backup Sentinel"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false

# Security (Generate a secure 32+ character random secret in production)
SECRET_KEY="replace-with-a-high-entropy-secret-key-min-32-characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (PostgreSQL for production, SQLite default for local development)
DATABASE_URL="sqlite:///./sentinel.db"
# DATABASE_URL="postgresql://sentinel:secure_password@localhost:5432/backup_sentinel"

# Storage Boundaries
ALLOWED_STORAGE_ROOTS=["./fixtures", "./backups", "/var/backups"]
MAX_BACKUP_SIZE_BYTES=10737418240
MAX_DECOMPRESSED_RATIO=100.0

# Docker Recovery Settings
ENABLE_DOCKER_RECOVERY=true
DOCKER_CONTAINER_TIMEOUT_SECONDS=60
